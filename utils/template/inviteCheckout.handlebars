<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>You're invited to subscribe to StoryGroove</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f4f7;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f1f1f;
      }
      .wrapper {
        width: 100%;
        padding: 32px 16px;
        box-sizing: border-box;
      }
      .card {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      }
      h1 {
        font-size: 22px;
        margin: 0 0 16px 0;
        color: #1f1f1f;
      }
      p {
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 16px 0;
      }
      .cta-wrap {
        text-align: center;
        margin: 24px 0;
      }
      .cta {
        display: inline-block;
        background: #0B1D2C;
        color: #ffffff !important;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 700;
      }
      .fallback {
        font-size: 13px;
        color: #4b5563;
        word-break: break-all;
      }
      .fallback a {
        color: #0B1D2C;
        text-decoration: underline;
      }
      .meta {
        font-size: 13px;
        color: #6b7280;
      }
      .footer {
        margin-top: 24px;
        font-size: 12px;
        color: #9ca3af;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <h1>You're invited to subscribe to StoryGroove</h1>
        <p>Hi {{name}},</p>
        <p>
          {{inviterName}} has prepared a personalised Stripe checkout link so
          you can start your StoryGroove subscription. Click the button below
          to review the plan and complete payment.
        </p>
        <div class="cta-wrap">
          <a class="cta" href="{{checkoutUrl}}" target="_blank" rel="noopener noreferrer">
            Start my subscription
          </a>
        </div>
        <p class="fallback">
          If the button doesn't work, copy and paste this URL into your browser:
          <br />
          <a href="{{checkoutUrl}}">{{checkoutUrl}}</a>
        </p>
        <p class="meta">
          This link is unique to you and may expire. If you didn't expect this
          invitation, you can safely ignore this email.
        </p>
      </div>
      <div class="footer">&copy; StoryGroove</div>
    </div>
  </body>
</html>
