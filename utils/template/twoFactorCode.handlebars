<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your StoryGroove verification code</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f4f7;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f1f1f;
      }
      .wrapper {
        width: 100%;
        padding: 32px 16px;
        box-sizing: border-box;
      }
      .card {
        max-width: 520px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      }
      h1 {
        font-size: 20px;
        margin: 0 0 16px 0;
        color: #1f1f1f;
      }
      p {
        font-size: 15px;
        line-height: 1.5;
        margin: 0 0 16px 0;
      }
      .code {
        display: inline-block;
        background: #f2f4f8;
        border: 1px solid #e1e5eb;
        border-radius: 8px;
        padding: 16px 24px;
        font-size: 28px;
        font-weight: 700;
        letter-spacing: 8px;
        color: #1f1f1f;
        margin: 8px 0 20px 0;
      }
      .meta {
        font-size: 13px;
        color: #6b7280;
      }
      .footer {
        margin-top: 24px;
        font-size: 12px;
        color: #9ca3af;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="card">
        <h1>Verify it's you</h1>
        <p>Hi {{name}},</p>
        <p>
          Use the verification code below to finish signing in to your
          StoryGroove superadmin account.
        </p>
        <div class="code">{{code}}</div>
        <p class="meta">
          This code expires in {{expiresInMinutes}} minutes. If you didn't try
          to sign in, you can safely ignore this email — your password has not
          been changed.
        </p>
      </div>
      <div class="footer">&copy; StoryGroove</div>
    </div>
  </body>
</html>
